# =====================================================================
# CARLITOS - Environment Configuration (example)
# Copy this file to `.env` and adjust values for your environment.
# =====================================================================

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
APP_NAME=CARLITOS
APP_ENV=development                 # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=debug                     # debug | info | warn | error

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=carlitos
POSTGRES_PASSWORD=carlitos_secret
POSTGRES_DB=carlitos
POSTGRES_SSLMODE=disable
# Full DSN used by the backend (built from the parts above by default).
DATABASE_URL=postgres://carlitos:carlitos_secret@localhost:5432/carlitos?sslmode=disable

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_HOURS=168
BCRYPT_COST=12

# ---------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------
# STORAGE_PROVIDER: local | cloudinary
#   Leave blank to auto-select: if Cloudinary credentials (below) are present
#   the app uses "cloudinary", otherwise it falls back to "local".
STORAGE_PROVIDER=

# -- local disk (served by the API's /media route) --
# Directory on the server where uploaded images are written.
STORAGE_LOCAL_ROOT=./.data/storage
# URL prefix the frontends use to load media. For local, point this at the
# API's /media route, e.g. https://api.example.com/media
# For Cloudinary, leave blank to auto-use the account's CDN delivery prefix
# (https://res.cloudinary.com/<cloud_name>/image/upload).
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/media

# -- Cloudinary (remote CDN storage; fast global image delivery) --
# When all three are set, uploads go to Cloudinary and media is served from its
# CDN. Existing local files are pushed with: go run ./cmd/media-migrate
# (keys are reused as Cloudinary public_ids, so DB image keys keep resolving).
# The variable names below match this project's existing .env; the conventional
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET also work.
NAME_CLOUDINARY=
API_KEY_CLOUDINART=
SECRET_KEY=
# Optional folder prefix for Cloudinary public_ids (leave blank to map 1:1).
CLOUDINARY_FOLDER=

# ---------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# ---- TEST mode example ----
# PAYMENT_PROVIDER=razorpay
# PAYMENT_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# PAYMENT_KEY_SECRET=your_test_key_secret
# PAYMENT_WEBHOOK_SECRET=your_test_webhook_secret

# ---- LIVE mode example ----
# PAYMENT_PROVIDER=razorpay
# PAYMENT_KEY_ID=rzp_live_xxxxxxxxxxxxxx
# PAYMENT_KEY_SECRET=your_live_key_secret
# PAYMENT_WEBHOOK_SECRET=your_live_webhook_secret

# ---------------------------------------------------------------------
# Shipping / Courier Provider (provider-agnostic: mock | shiprocket | delhivery | bluedart)
# For development the `mock` adapter is used and needs no credentials.
# For Shiprocket: set SHIPPING_PROVIDER=shiprocket and use your API user's
#   email as SHIPPING_API_KEY and password as SHIPPING_API_SECRET.
# SHIPPING_WEBHOOK_TOKEN is a shared secret you also configure in the Shiprocket
#   webhook settings; it is validated (x-api-key header) on the tracking webhook.
# ---------------------------------------------------------------------
SHIPPING_PROVIDER=mock
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
SHIPPING_BASE_URL=
SHIPPING_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------
# Notifications
# EMAIL_PROVIDER: log (dev, no emails sent) | smtp (Brevo / any SMTP)
# For Brevo SMTP:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<your-brevo-login-email>
#   SMTP_PASSWORD=<your-brevo-smtp-api-key>   ← NOT your Brevo account password
#   EMAIL_FROM=no-reply@yourdomain.com         ← must be a verified Brevo sender
# Brevo free tier: 300 emails/day, no credit card required.
# Docs: https://help.brevo.com/hc/en-us/articles/209462765
# ---------------------------------------------------------------------
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@carlitos.in
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS / mobile OTP.
#   SMS_PROVIDER=log      → dev/test: OTPs are logged, test code 123456 works, NO real SMS.
#   SMS_PROVIDER=apihome  → real SMS via apihome.in bulksms (needs SMS_API_KEY).
# Switch to apihome + set SMS_API_KEY when you go live; keep "log" for testing.
SMS_PROVIDER=log
SMS_SENDER_ID=CRLTOS
SMS_API_KEY=
SMS_BASE_URL=https://apihome.in/panel/api/bulksms/

# ---------------------------------------------------------------------
# CORS - allowed origins for the three frontends
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---------------------------------------------------------------------
# Marketplace defaults
# ---------------------------------------------------------------------
DEFAULT_COMMISSION_PERCENT=12.0
DEFAULT_CURRENCY=INR

# ---------------------------------------------------------------------
# Frontend (Vite) - each app reads VITE_API_BASE_URL
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
