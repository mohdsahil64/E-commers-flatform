# =====================================================================
# CARLITOS - LOCAL development overrides
# ---------------------------------------------------------------------
# Copy this file to  .env.local  on your Mac/laptop. It is loaded ONLY in
# development (APP_ENV != production) and OVERRIDES values in the base .env,
# so local runs use localhost DB/Redis, test keys, and logged OTP/email.
#
# How environment selection works (see backend/internal/config/config.go):
#   - APP_ENV=production  -> loads .env.production (on the VPS)
#   - APP_ENV=development -> loads .env.local  (here, on your machine)
#   - real OS env vars always win over any file
#   - .env is the shared base both read
#
# So: keep APP_ENV=development here, APP_ENV=production on the server, and the
# same code picks the right values on each machine automatically.
# =====================================================================

APP_ENV=development
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=debug

# ---- Local PostgreSQL ----
DATABASE_URL=postgres://carlitos:carlitos_secret@localhost:5432/carlitos?sslmode=disable

# ---- Local Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Dev-friendly providers: no real money, no real SMS/email ----
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=rzp_test_xxxxxxxxxxxxx
PAYMENT_KEY_SECRET=your_test_key_secret

SHIPPING_PROVIDER=mock

EMAIL_PROVIDER=log
SMS_PROVIDER=log

# ---- CORS: the three local Vite dev servers ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# JWT dev secrets are fine locally (production refuses the dev defaults).
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret-different
